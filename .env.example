# Server Port
PORT=3000

# Web Application Base URL (used in email links)
# For production: Set to your actual deployed domain, e.g. https://slsulucena-scheduling-system.web.app
APP_BASE_URL=https://slsulucena-scheduling-system.web.app

# Email / SMTP Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-google-app-password
EMAIL_FROM="SLSU Lucena Scheduling System <your-email@gmail.com>"

# Firebase Service Account (JSON string for Render/cloud environments, or leave empty if serviceAccountKey.json is used locally)
FIREBASE_SERVICE_ACCOUNT=
