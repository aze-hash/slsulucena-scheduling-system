# Server Port
PORT=3000

# Web Application Base URL (used in email links)
# For production: Set to your actual deployed domain, e.g. https://slsulucena-scheduling-system.firebaseapp.com
APP_BASE_URL=https://slsulucena-scheduling-system.firebaseapp.com

# Email / SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="SLSU Lucena Scheduling System <no-reply@slsulucena.edu.ph>"

# Firebase Service Account (JSON string for cloud environments, or leave empty if serviceAccountKey.json is used locally)
FIREBASE_SERVICE_ACCOUNT=
